# ==============================================================
# 复制为 .env 后填入你自己的值（.env 已被 .gitignore 忽略，不会上传）
# ==============================================================

# ---------- AI 服务（任意 OpenAI 兼容接口） ----------
# 必填：你的 API Key
RELAY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 必填：OpenAI 兼容的 Base URL（注意通常需要带 /v1）
# 示例：
#   官方 OpenAI:        https://api.openai.com/v1
#   DeepSeek:           https://api.deepseek.com/v1
#   智谱 GLM:           https://open.bigmodel.cn/api/paas/v4
#   Moonshot:           https://api.moonshot.cn/v1
#   自建 OneAPI/relay:  https://your-relay.example.com/v1
RELAY_BASE_URL=https://api.openai.com/v1

# 必填：模型名（要与你的 BASE_URL 后端实际可用模型对应）
# 示例：gpt-4o-mini / deepseek-chat / glm-4 / moonshot-v1-8k
RELAY_MODEL=gpt-4o-mini


# ---------- 部署相关 ----------
# 前端对外端口（容器 80 → 宿主 ${WEB_PORT}）
WEB_PORT=8888

# 后端 CORS 允许域（同源反代时无需修改）
CORS_ORIGINS=http://localhost,http://localhost:8888,http://127.0.0.1:8888
